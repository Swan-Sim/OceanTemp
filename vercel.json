{
  "functions": {
    "api/regional.js": {
      "maxDuration": 120
    },
    "api/world.js": {
      "maxDuration": 60
    },
    "api/cmems.js": {
      "maxDuration": 60
    },
    "api/spotobs.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/shops?svc=cron",
      "schedule": "7 0 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/khoa",
      "destination": "/api/regional?_h=khoa"
    },
    {
      "source": "/api/kma",
      "destination": "/api/regional?_h=kma"
    },
    {
      "source": "/api/jmatide",
      "destination": "/api/regional?_h=jmatide"
    },
    {
      "source": "/api/busanwq",
      "destination": "/api/regional?_h=busanwq"
    },
    {
      "source": "/api/noaa",
      "destination": "/api/world?_h=noaa"
    },
    {
      "source": "/api/sst",
      "destination": "/api/world?_h=sst"
    },
    {
      "source": "/api/visibility",
      "destination": "/api/world?_h=visibility"
    },
    {
      "source": "/api/track",
      "destination": "/api/world?_h=track"
    },
    {
      "source": "/api/hycom",
      "destination": "/api/world?_h=hycom"
    },
    {
      "source": "/api/storms",
      "destination": "/api/world?_h=storms"
    },
    {
      "source": "/auth/start/:p(google|kakao|naver|facebook)",
      "destination": "/api/shops?svc=auth&a=start&p=:p"
    },
    {
      "source": "/auth/callback/:p(google|kakao|naver|facebook)",
      "destination": "/api/shops?svc=auth&a=cb&p=:p"
    },
    {
      "source": "/auth/fb-delete",
      "destination": "/api/shops?svc=auth&a=fbdelete"
    },
    {
      "source": "/:lang(ko|en|ja|es|zh)/r",
      "destination": "/api/spotobs?svc=regions&lang=:lang"
    },
    {
      "source": "/:lang(ko|en|ja|es|zh)/r/",
      "destination": "/api/spotobs?svc=regions&lang=:lang"
    },
    {
      "source": "/:lang(ko|en|ja|es|zh)/r/:slug",
      "destination": "/api/spotobs?svc=region&lang=:lang&slug=:slug"
    },
    {
      "source": "/:lang(ko|en|ja|es|zh)/s",
      "destination": "/api/spotobs?svc=index&lang=:lang"
    },
    {
      "source": "/:lang(ko|en|ja|es|zh)/s/",
      "destination": "/api/spotobs?svc=index&lang=:lang"
    },
    {
      "source": "/:lang(ko|en|ja|es|zh)/s/:no(\\d+)",
      "destination": "/api/spotobs?svc=page&lang=:lang&no=:no"
    },
    {
      "source": "/:lang(ko|en|ja|es|zh)/s/:no(\\d+)/:slug",
      "destination": "/api/spotobs?svc=page&lang=:lang&no=:no&slug=:slug"
    },
    {
      "source": "/s/:no(\\d+)",
      "destination": "/api/spotobs?svc=page&no=:no"
    },
    {
      "source": "/s/:no(\\d+)/:slug",
      "destination": "/api/spotobs?svc=page&no=:no&slug=:slug"
    },
    {
      "source": "/:lang(ko|en|ja|es|zh)/t",
      "destination": "/api/spotobs?svc=storms&lang=:lang"
    },
    {
      "source": "/:lang(ko|en|ja|es|zh)/t/",
      "destination": "/api/spotobs?svc=storms&lang=:lang"
    },
    {
      "source": "/:lang(ko|en|ja|es|zh)/t/:slug",
      "destination": "/api/spotobs?svc=storm&lang=:lang&slug=:slug"
    },
    {
      "source": "/t/:slug",
      "destination": "/api/spotobs?svc=storm&slug=:slug"
    },
    {
      "source": "/:key([a-f0-9]{16,64}).txt",
      "destination": "/api/spotobs?svc=inkey&k=:key"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/spotobs?svc=sitemap"
    },
    {
      "source": "/:name((?!(?:api|admin|shop|terms|privacy|guide|auth|spot|s|r|t|ko|en|ja|es|zh|js|css|icons|bg|data|scripts|index|offline|_vercel)(?:/|$))[^/.]+)",
      "destination": "/api/spotobs?svc=go&name=:name"
    }
  ]
}
